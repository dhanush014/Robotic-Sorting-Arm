<?xml version="1.0"?>
<sdf version="1.10">

  <model name="red_cube">

    <link name="cube_link">

      <!-- Physical properties. 0.07 m wide to fit the AG-95's 95 mm max opening. -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0000817</ixx>
          <iyy>0.0000817</iyy>
          <izz>0.0000817</izz>
        </inertia>
      </inertial>

      <!-- Collision geometry -->
      <collision name="cube_collision">
        <geometry>
          <box>
            <size>0.07 0.07 0.07</size>
          </box>
        </geometry>
      </collision>

      <!-- Visible geometry -->
      <visual name="cube_visual">
        <geometry>
          <box>
            <size>0.07 0.07 0.07</size>
          </box>
        </geometry>

        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>