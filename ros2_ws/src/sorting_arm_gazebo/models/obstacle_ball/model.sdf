<?xml version="1.0" ?>

<sdf version="1.10">

  <model name="obstacle_ball">
  
    <static>true</static>

    <link name="link">

      <!-- Ball body -->
      <visual name="base_visual">
        <pose>0 0 0.05 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.0 1.0 0.50 1</ambient>
          <diffuse>0.0 1.0 0.50 1</diffuse>
        </material>
      </visual>
      

      <!-- Simple collision geometry -->
      <collision name="collision">

        <pose>0 0 0.05 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>

      </collision>
      
    </link>

  </model>
  
</sdf>