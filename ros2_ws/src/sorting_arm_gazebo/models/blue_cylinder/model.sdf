<?xml version="1.0"?>
<sdf version="1.10">

  <model name="blue_cylinder">

    <link name="cylinder_link">

      <!-- Physical properties -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000083</ixx>
          <iyy>0.000083</iyy>
          <izz>0.000125</izz>
        </inertia>
      </inertial>

      <!-- Collision geometry -->
      <collision name="cylinder_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Visible geometry -->
      <visual name="cylinder_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.8 1</ambient>
          <diffuse>0.1 0.1 0.8 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>