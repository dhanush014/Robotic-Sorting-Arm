<?xml version="1.0"?>
<sdf version="1.10">

  <model name="red_cylinder">

    <link name="cylinder_link">

      <!-- Physical properties. 0.07 m diameter to fit the AG-95's 95 mm max opening. -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000114</ixx>
          <iyy>0.000114</iyy>
          <izz>0.0000613</izz>
        </inertia>
      </inertial>

      <!-- Collision geometry -->
      <collision name="cylinder_collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Visible geometry -->
      <visual name="cylinder_visual">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>