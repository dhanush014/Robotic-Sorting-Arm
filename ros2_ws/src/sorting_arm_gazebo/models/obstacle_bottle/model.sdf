<?xml version="1.0" ?>

<sdf version="1.10">

  <model name="obstacle_bottle">
  
    <static>true</static>

    <link name="link">

      <!-- Bottle body -->
      <visual name="body_visual">
        <pose>0 0 0.075 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.7 0.8 0.9 1</ambient>
          <diffuse>0.7 0.8 0.9 1</diffuse>
        </material>
      </visual>


      <!-- Bottle neck -->
      <visual name="neck_visual">
        <pose>0 0 0.165 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.7 0.8 0.9 1</ambient>
          <diffuse>0.7 0.8 0.9 1</diffuse>
        </material>
      </visual>


      <!-- Bottle cap -->
      <visual name="cap_visual">
        <pose>0 0 0.185 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.027</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>


      <!-- Simple collision geometry -->
      <collision name="collision">

        <pose>0 0 0.075 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.15</length>
          </cylinder>
        </geometry>

      </collision>

    </link>

  </model>

</sdf>